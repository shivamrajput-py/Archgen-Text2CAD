# ============================================================
# ArchgenCAD Frontend — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your backend URL.
# NEVER commit .env.local — it is gitignored.
#
# Usage:
#   cp .env.example .env.local
#   # edit .env.local with your backend URL
# ============================================================

# ── Backend API URL ──────────────────────────────────────────
# For local development (default — no change needed):
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# For production (replace with your EC2/server URL):
# VITE_API_BASE_URL=https://api.archgen.in
# VITE_WS_BASE_URL=wss://api.archgen.in
