# ============================================================
# ArchgenCAD Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your own API keys.
# NEVER commit the actual .env file — it is gitignored.
#
# Usage:
#   cp .env.example .env
#   # then edit .env with your real keys
# ============================================================

# ── LLM Routing (required) ──────────────────────────────────
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# ── Vector Database (required) ───────────────────────────────
# Create a free account at: https://www.pinecone.io/
# Create an index named 'archgencad' with:
#   Dimensions: 384
#   Metric: cosine
#   Pod type: Starter (free)
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX=archgencad

# ── Reranking & Embeddings (required) ────────────────────────
# Get your key at: https://cohere.com/ (free trial available)
COHERE_API_KEY=your-cohere-api-key-here

# ── FreeCAD Path (optional — auto-detected if not set) ───────
# Uncomment and set if FreeCAD is not in a standard location:
# FREECAD_PATH=/usr/bin/FreeCADCmd
# FREECAD_PATH=C:/Program Files/FreeCAD 1.0/bin/FreeCADCmd.exe

# ── Feature Flags (optional) ─────────────────────────────────
# Set to false to disable actual FreeCAD execution (LLM-only mode)
# ENABLE_FREECAD_EXECUTION=true

# ── Session & Quota Settings (optional) ──────────────────────
# MAX_SESSIONS=100
# SESSION_TIMEOUT_HOURS=24
# FREECAD_TIMEOUT_SECONDS=600
